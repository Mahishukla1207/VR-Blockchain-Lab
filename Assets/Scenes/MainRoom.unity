  m_Script: {fileID: 11500000, guid: 23d69353332a352448e80142dafc1770, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionArea: {fileID: 919094078}
  questionText: {fileID: 2070239862}
  optionTexts:
  - {fileID: 1244404692}
  - {fileID: 948223800}
  - {fileID: 1171269109}
  - {fileID: 1376792012}
  feedbackText: {fileID: 1837657064}
  resultPanel: {fileID: 42136947}
  resultTitleText: {fileID: 1718995134}
  scoreText: {fileID: 482343747}
  resultMessageText: {fileID: 2113904162}
  questions:
  - question: 'What does centralization mean in a system?

'
    optionA: Data is controlled by one central authority
    optionB: Data is shared equally by all users
    optionC: Data is not stored anywhere
    optionD: Data is randomly distributed
    correctAnswerIndex: 0
  - question: "Which of the following is an example of a centralized system?\r"
    optionA: Blockchain network
    optionB: Peer-to-peer file sharing
    optionC: Traditional bank database
    optionD: Decentralized application
    correctAnswerIndex: 2
  - question: 'In a centralized system, where does all data usually pass through?

'
    optionA: ' Multiple user devices'
    optionB: A single central server
    optionC: A public ledger
    optionD: Random nodes
    correctAnswerIndex: 1
  - question: "What is a single point of failure?\r"
    optionA: When data is encrypted
    optionB: When users forget passwords
    optionC: When one failure can stop the entire system
    optionD: When many servers fail together
    correctAnswerIndex: 2
  - question: 'What is a ledger in blockchain?

'
    optionA: A type of cryptocurrency
    optionB: A server computer
    optionC: A record of transactions
    optionD: A user account
    correctAnswerIndex: 2
  - question: 'What makes a distributed ledger different from a traditional ledger?

'
    optionA: It is stored on one powerful server
    optionB: It is shared across many computers
    optionC: It is private and hidden
    optionD: It cannot store transactions
    correctAnswerIndex: 1
  - question: 'What is a node in a blockchain network?

'
    optionA: A hacker
    optionB: A central authority
    optionC: A computer participating in the network
    optionD: A transaction record
    correctAnswerIndex: 2
  - question: 'What does peer-to-peer (P2P) mean?

'
    optionA: Data flows from one central server
    optionB: Nodes communicate directly with each other
    optionC: Users communicate only with companies
    optionD: Data is stored offline
    correctAnswerIndex: 1
  - question: 'In a decentralized network, who controls the system?

'
    optionA: One central authority
    optionB: A fixed group of servers
    optionC: All nodes equally
    optionD: Only developers
    correctAnswerIndex: 2
  - question: "What does \u201Ctrustless\u201D mean in blockchain systems?\r\n"
    optionA: Nobody trusts the system
    optionB: Trust is replaced by verification and consensus
    optionC: The system is insecure
    optionD: Only developers are trusted
    correctAnswerIndex: 1
